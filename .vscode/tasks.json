{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Build AmazonFX frontend",
			"type": "shell",
			"command": "npm",
			"args": [
				"--prefix",
				"frontend",
				"run",
				"build"
			],
			"isBackground": false,
			"problemMatcher": [
				"$tsc"
			],
			"group": "build"
		},
		{
			"label": "Install AmazonFX API dependencies",
			"type": "shell",
			"command": "npm",
			"args": [
				"--prefix",
				"backend",
				"install"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Test AmazonFX API",
			"type": "shell",
			"command": "npm",
			"args": [
				"--prefix",
				"backend",
				"test"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Run AmazonFX API",
			"type": "shell",
			"command": "npm",
			"args": [
				"--prefix",
				"backend",
				"run",
				"dev"
			],
			"isBackground": true,
			"problemMatcher": []
		},
		{
			"label": "Update AmazonFX API lockfile",
			"type": "shell",
			"command": "npm",
			"args": [
				"--prefix",
				"backend",
				"install"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Start AmazonFX API server",
			"type": "shell",
			"command": "npm",
			"args": [
				"--prefix",
				"backend",
				"run",
				"dev"
			],
			"isBackground": true,
			"problemMatcher": []
		},
		{
			"label": "Build AmazonFX landing and profile",
			"type": "shell",
			"command": "npm",
			"args": [
				"--prefix",
				"frontend",
				"run",
				"build"
			],
			"isBackground": false,
			"problemMatcher": [
				"$tsc"
			],
			"group": "build"
		},
		{
			"label": "Test AmazonFX profile API",
			"type": "shell",
			"command": "npm",
			"args": [
				"--prefix",
				"backend",
				"test"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Typecheck AmazonFX frontend",
			"type": "shell",
			"command": "npm",
			"args": [
				"--prefix",
				"frontend",
				"run",
				"typecheck"
			],
			"isBackground": false,
			"problemMatcher": [
				"$tsc"
			]
		},
		{
			"label": "Run AmazonFX frontend",
			"type": "shell",
			"command": "npm",
			"args": [
				"--prefix",
				"frontend",
				"run",
				"dev",
				"--",
				"--host",
				"127.0.0.1"
			],
			"isBackground": true,
			"problemMatcher": []
		}
	]
}